# Server-side URL used by the Next.js /api rewrite.
BACKEND_URL=http://localhost:8080

# Browser connects directly to Spring Boot for STOMP over WebSocket.
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8080/api/ws/tracking

# Use a browser-restricted Maps JavaScript API key. Never reuse an unrestricted server key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID

# Free fallback for browser map tiles. Keep the actual value in .env.local only.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
