SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shiptrack
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-postgresql-password
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-64-characters

# Google is tried first when configured.
GOOGLE_MAPS_API_KEY=

# Geoapify is the free fallback. One key can be used for both values.
GEOAPIFY_GEOCODING_API_KEY=
GEOAPIFY_ROUTING_API_KEY=
GEOAPIFY_COUNTRY_CODE=in

# Set MAIL_ENABLED=true after adding an SMTP username and app password.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
NOTIFICATION_DUPLICATE_WINDOW_MINUTES=5

# Proof-of-delivery images are stored locally and this folder is ignored by Git.
POD_UPLOAD_DIR=uploads/pod

WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
